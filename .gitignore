# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# migration artifacts (regenerated by scripts/rewrite-html.mjs)
/_capture_raw.html

# local browser comparison snapshots
/.claude-browser/

# transient QA/test run artifacts (the curated .qa-visual baselines + launchproof knowledge
# files are tracked deliberately; these are per-run outputs that only pollute git status)
/test-results/
.launchproof/*.log
.launchproof/fix-state.json

# Claude Code local (machine-specific perms)
.claude/settings.local.json
.stripe-setup.json

.env*.local

# rendered email previews (regenerate: node .qa-visual/welcome-email-preview.mjs)
.qa-visual/out/

# Capacitor iOS: the project is committed, the build output and CocoaPods are not.
ios/App/Pods/
ios/App/App/public/
ios/App/output/
ios/DerivedData/

# Lenus export working area. Holds a live session cookie (lenus-session.json) and 400MB of her
# video footage; neither belongs in git. The recipe book is a set of query templates plus auth
# headers, so it is a credential too.
/.capture/

# Lenus captures land here (Chrome downloads to .planning on this machine).
# Her programming and client data: large and her IP. Keep on disk, never in git.
.planning/lenus-*.json

# Client exports from /coach/clients. Same rule as the Lenus captures above, and it matters more
# here: these carry every member's email and phone. A commit puts them in history permanently, so
# removing one later means rewriting history, not deleting a file.
/thickandfit-clients-*.csv

# Dev server log and shell-redirect debris. Regenerated on every run, useful to nobody else.
/dev.log
/0

# Supabase CLI local state. cli-latest and linked-project.json are already tracked and stay that
# way; everything else here is per-machine (pooler URL, installed component versions).
supabase/.temp/
