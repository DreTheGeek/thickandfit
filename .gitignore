# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# migration artifacts (regenerated by scripts/rewrite-html.mjs)
/_capture_raw.html

# local browser comparison snapshots
/.claude-browser/

# transient QA/test run artifacts (the curated .qa-visual baselines + launchproof knowledge
# files are tracked deliberately; these are per-run outputs that only pollute git status)
/test-results/
.launchproof/*.log
.launchproof/fix-state.json

# Claude Code local (machine-specific perms)
.claude/settings.local.json
.stripe-setup.json

.env*.local

# rendered email previews (regenerate: node .qa-visual/welcome-email-preview.mjs)
.qa-visual/out/
