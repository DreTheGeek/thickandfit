{
  "repoRoot": ".",
  "stage": "pre-launch",
  "priority": "the-works",
  "safeTarget": "https://thickandfit.vercel.app",

  "surfaces": [
    {
      "name": "app",
      "baseURL": "https://thickandfit.vercel.app",
      "auth": true,
      "routes": [
        "/dashboard",
        "/exercises",
        "/history",
        "/forms/[id]",
        "/workout/[planId]",
        "/nutrition",
        "/community",
        "/you",
        "/inbox",
        "/account/billing"
      ]
    },
    {
      "name": "coach",
      "baseURL": "https://thickandfit.vercel.app",
      "auth": true,
      "routes": [
        "/coach",
        "/coach/clients",
        "/coach/inbox",
        "/coach/programs",
        "/coach/forms/[id]",
        "/coach/subscribers"
      ]
    },
    {
      "name": "public",
      "baseURL": "https://thickandfit.vercel.app",
      "auth": false,
      "routes": [
        "/",
        "/join",
        "/auth/sign-in",
        "/auth/sign-up",
        "/auth/forgot-password"
      ]
    }
  ],

  "roles": [
    {
      "name": "subscriber",
      "surface": "app",
      "loginUrl": "https://thickandfit.vercel.app/auth/sign-in",
      "credEnv": {
        "email": "LP_SUBSCRIBER_EMAIL",
        "password": "LP_SUBSCRIBER_PASSWORD"
      }
    },
    {
      "name": "coach",
      "surface": "coach",
      "loginUrl": "https://thickandfit.vercel.app/auth/sign-in",
      "credEnv": {
        "email": "LP_COACH_EMAIL",
        "password": "LP_COACH_PASSWORD"
      }
    },
    {
      "name": "free",
      "surface": "app",
      "loginUrl": "https://thickandfit.vercel.app/auth/sign-in",
      "credEnv": {
        "email": "LP_FREE_EMAIL",
        "password": "LP_FREE_PASSWORD"
      }
    }
  ],

  "supabase": {
    "projectRef": "cpwesaeyhklmjbqppeah",
    "tokenEnv": "LP_SUPABASE_ACCESS_TOKEN"
  },

  "loginSelectors": {
    "emailField": "input[type=email]",
    "passwordField": "input[type=password]",
    "submitButton": "button[type=submit]"
  },

  "destructive": false,
  "sandbox": true,

  "credsFile": ".env.launchproof"
}
